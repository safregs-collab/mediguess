  "details": {
    "anaphylactic_shock": {
      "description": "Анафилактический шок — тяжёлая, потенциально фатальная системная гиперчувствительная реакция с быстрым началом. Смертность 0.5-2%.",
      "criteria": [
        "Острое начало (минуты-часы) после контакта с аллергеном",
        "Кожные и/или слизистые симптомы (крапивница, отёк, зуд)",
        "Дыхательные симптомы (одышка, стридор, бронхоспазм)",
        "Сердечно-сосудистые симптомы (гипотензия, коллапс, тахикардия)",
        "ЖКТ симптомы (тошнота, рвота, диарея, боль в животе)"
      ],
      "prevalence": "1-3% населения за жизнь",
      "complications": [
        "Остановка сердца",
        "Асфиксия (отёк гортани)",
        "Ишемия миокарда (Kounis syndrome)",
        "Острая почечная недостаточность",
        "ДИК-синдром",
        "Смерть"
      ],
      "treatment": [
        "Адреналин 0.3-0.5 мг в/м (бедро) немедленно — повтор каждые 5-15 мин",
        "Положение: лёжа с приподнятыми ногами (кроме одышки)",
        "Кислород 100% 10-15 л/мин",
        "0.9% NaCl 1-2 л в/в быстро (гипотензия)",
        "β2-агонисты при бронхоспазме (сальбутамол)",
        "Н1-антагонисты (цетиризин) и Н2-антагонисты (ранитидин)",
        "Глюкокортикоиды (преднизолон) — при длительных симптомах",
        "При отсутствии эффекта — адреналин в/в инфузия 0.05-0.1 мкг/кг/мин"
      ],
      "followup": "Наблюдение 6-12 часов (бивалентная реакция), выдача автоинъектора адреналина, консультация аллерголога"
    },
    "anaphylaxis_without_shock": {
      "description": "Анафилаксия без гипотензии — системная аллергическая реакция с вовлечением дыхательных путей или ЖКТ, но без шока.",
      "criteria": [
        "Контакт с аллергеном + 2 системы:",
        "Кожа/слизистые + дыхательная система",
        "Или кожа/слизистые + ЖКТ",
        "Без гипотензии (<90 мм рт.ст. систолическое)"
      ],
      "prevalence": "2-5% населения за жизнь",
      "complications": [
        "Прогрессирование до анафилактического шока",
        "Бронхоспазм",
        "Отёк гортани"
      ],
      "treatment": [
        "Адреналин 0.3 мг в/м (при угрозе шока или дыхательной недостаточности)",
        "Н1-антагонисты (цетиризин 10 мг)",
        "β2-агонисты при бронхоспазме",
        "Наблюдение 4-6 часов"
      ],
      "followup": "Консультация аллерголога, определение аллергена, иммунотерапия"
    }
  },
