  "details": {
    "variceal_bleeding": {
      "description": "Кровотечение из варикозно расширенных вен пищевода или желудка — наиболее опасное осложнение портальной гипертензии. Смертность 15-20%.",
      "criteria": [
        "Рвота кровью или «кофейной гущей»",
        "Мелена",
        "Гемодинамическая нестабильность",
        "ЭГДС: вариксы с активным кровотечением или знаками недавнего кровотечения"
      ],
      "prevalence": "5-10% всех ЖКК",
      "complications": [
        "Аспирационная пневмония",
        "Печёночная энцефалопатия",
        "Бактериальный перитонит",
        "Рецидивное кровотечение (до 60% в первые 6 недель)"
      ],
      "treatment": [
        "Терлипрессин 2 мг в/в болюс, затем 1 мг каждые 4 часа",
        "Октреотид 50 мкг в/в болюс, затем 50 мкг/час",
        "Эндоскопическое лигирование вариксов (первый выбор)",
        "Трансфузия эритроцитов (Hb <70-80 г/л)",
        "Антибиотики профилактически (цефотаксим/ципрофлоксацин)",
        "При неудаче: баллонная тампонада (Sengstaken-Blakemore), TIPS"
      ],
      "followup": "Повторная ЭГДС через 2-4 недели, бета-блокаторы (пропранолол), повторное лигирование"
    },
    "peptic_ulcer_bleeding": {
      "description": "Кровотечение из язвы желудка или двенадцатиперстной кишки — наиболее частая причина верхнего ЖКК (40%).",
      "criteria": [
        "Рвота «кофейной гущей» или кровью",
        "Мелена",
        "ЭГДС: язва с видимым сосудом, активное кровотечение или сгусток крови"
      ],
      "prevalence": "40% верхнего ЖКК",
      "complications": [
        "Рецидивное кровотечение (10-30%)",
        "Перфорация язвы",
        "Аспирационная пневмония"
      ],
      "treatment": [
        "Эндоскопическая гемостазия (инъекция адреналина, клипирование, термокоагуляция)",
        "ИПП в/в (пантопразол 80 мг болюс + 8 мг/час инфузия)",
        "Трансфузия при Hb <70-80 г/л",
        "Эрадикация H. pylori",
        "Отмена НПВС/антикоагулянтов"
      ],
      "followup": "Повторная ЭГДС через 24 часа при высоком риске, эрадикация H. pylori"
    }
  },
