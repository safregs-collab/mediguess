  "details": {
    "acute_calculous_cholecystitis": {
      "description": "Острый калькулёзный холецистит — острое воспаление желчного пузыря, вызванное закупоркой шейки камнем. Наиболее частое осложнение желчнокаменной болезни.",
      "criteria": [
        "Боль в правом подреберье",
        "Положительный симптом Мёрфи",
        "Лихорадка",
        "Лейкоцитоз",
        "УЗИ: утолщение стенки >4 мм, камни, жидкость вокруг пузыря"
      ],
      "prevalence": "10-20% населения (желчнокаменная болезнь), 1-3% — острый холецистит",
      "complications": [
        "Перфорация желчного пузыря",
        "Эмпиема пузыря",
        "Гангрена пузыря",
        "Холедохолитиаз",
        "Билиарный панкреатит",
        "Мирицци-синдром"
      ],
      "treatment": [
        "НПВС (диклофенак, кеторолак) — первый выбор для обезболивания",
        "Антибиотики (цефалоспорины + метронидазол) при тяжёлом течении",
        "Лапароскопическая холецистэктомия в течение 72 часов (ранняя)",
        "Отсроченная холецистэктомия через 6-8 недель при высоком риске",
        "Пункция/дренаж при эмпиеме или абсцессе"
      ],
      "followup": "При консервативном лечении — плановая холецистэктомия через 6-8 недель"
    },
    "cholangitis": {
      "description": "Острый холангит — бактериальная инфекция желчных протоков, обычно на фоне обструкции. Синдром Шарко: боль, лихорадка, желтуха.",
      "criteria": [
        "Лихорадка и озноб",
        "Боль в правом подреберье",
        "Желтуха",
        "Повышение билирубина и ЩФ",
        "ЭРХПГ: расширение желчных протоков, камень"
      ],
      "prevalence": "6-9% пациентов с холедохолитиазом",
      "complications": [
        "Септический шок",
        "Печёночный абсцесс",
        "Билиарный цирроз"
      ],
      "treatment": [
        "ЭРХПГ + папиллосфинктеротомия + экстракция камня (в течение 24-48 часов)",
        "Антибиотики (пиперациллин/тазобактам или карбапенемы)",
        "Временный дренаж (назобилиарный или чрескожный) при неудаче ЭРХПГ",
        "Холецистэктомия после стабилизации"
      ],
      "followup": "Холецистэктомия после купирования холангита"
    }
  },
