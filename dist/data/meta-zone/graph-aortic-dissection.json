  "details": {
    "stanford_type_a": {
      "description": "Расслоение аорты типа A (Stanford) — вовлекает восходящую аорту независимо от места проксимального разрыва интимы. Требует экстренного хирургического вмешательства.",
      "criteria": [
        "Вовлечение восходящей аорты (любой сегмент)",
        "Может распространяться на дугу и нисходящую аорту",
        "Соответствует DeBakey I и II"
      ],
      "prevalence": "60-65% всех расслоений",
      "complications": [
        "Острая аортальная недостаточность",
        "Тампонада сердца (перикардальный выпот)",
        "ОИМ (закупорка устья коронарных артерий)",
        "Инсульт (закупорка брахиоцефальных артерий)",
        "Острая почечная недостаточность",
        "Ишемия кишечника",
        "Разрыв аорты"
      ],
      "treatment": [
        "Экстренная операция (замена восходящей аорты)",
        "Коррекция аортальной недостаточности",
        "Антигипертензивная терапия (β-блокаторы + НПС)",
        "Мониторинг в ОРИТ"
      ],
      "followup": "КТ-контроль через 3, 6, 12 месяцев, затем ежегодно"
    },
    "stanford_type_b": {
      "description": "Расслоение аорты типа B (Stanford) — не вовлекает восходящую аорту, начинается дистальнее устья левой подключичной артерии. Консервативное/эндоваскулярное лечение.",
      "criteria": [
        "Не вовлекает восходящую аорту",
        "Начинается дистальнее левой подключичной артерии",
        "Соответствует DeBakey III"
      ],
      "prevalence": "35-40% всех расслоений",
      "complications": [
        "Ишемия нижних конечностей",
        "Ишемия кишечника (закупорка брыжеечных артерий)",
        "Острая почечная недостаточность",
        "Расширение ложной просвета",
        "Разрыв нисходящей аорты"
      ],
      "treatment": [
        "Консервативное: β-блокаторы + НПС (цель САД <120 мм рт.ст.)",
        "TEVAR (торакальная эндопротезирование) при осложнениях",
        "Анальгезия (морфин)",
        "Мониторинг в ОРИТ"
      ],
      "followup": "КТ-контроль через 1, 3, 6, 12 месяцев, затем ежегодно"
    }
  },
