  "details": {
    "bacterial_meningitis": {
      "description": "Бактериальный менингит — острое инфекционное заболевание оболочек головного мозга. Возбудители: пневмококк, менингококк, гемофильная палочка, листерия.",
      "criteria": [
        "Лихорадка >38°C",
        "Головная боль",
        "Ригидность затылочных мышц",
        "Лейкоциты ликвора >1000/мкл",
        "Глюкоза ликвора снижена (<2.2 ммоль/л)",
        "Лактат ликвора >3.5 ммоль/л",
        "Прокальцитонин >0.5 нг/мл"
      ],
      "prevalence": "0.5-5 на 100 000 населения в год",
      "complications": [
        "Внутричерепная гипертензия",
        "Судороги",
        "Гидроцефалия",
        "Субдуральный эмпиема",
        "Сенсоневральная тугоухость",
        "Когнитивные нарушения"
      ],
      "treatment": [
        "Эмпирическая антибиотикотерапия в течение 1 часа (цефтриаксон 2г + ванкомицин + ампициллин)",
        "Дексаметазон 0.15 мг/кг до или с первой дозой антибиотика",
        "Интенсивная терапия, контроль ВЧД",
        "Профилактика контактам при менингококковом менингите (рифампицин/ципрофлоксацин)"
      ],
      "followup": "Контроль ЛП через 48 часов, аудиометрия при выписке"
    },
    "viral_meningitis": {
      "description": "Вирусный (асептический) менингит — наиболее частая форма менингита. Возбудители: энтеровирусы (Коксаки, Эхо), герпесвирусы, ВИЧ.",
      "criteria": [
        "Лихорадка",
        "Головная боль",
        "Ригидность затылочных мышц",
        "Лейкоциты ликвора 10-500/мкл (лимфоциты)",
        "Глюкоза ликвора нормальная",
        "Лактат ликвора <2.5 ммоль/л",
        "Прокальцитонин <0.5 нг/мл"
      ],
      "prevalence": "11 на 100 000 населения в год",
      "complications": [
        "Вирусный энцефалит",
        "Синдром Guillain-Barré (редко)"
      ],
      "treatment": [
        "Симптоматическая терапия (анальгетики, антипиретики)",
        "Ацикловир при подозрении на HSV/VZV",
        "Госпитализация для исключения бактериального менингита"
      ],
      "followup": "Амбулаторное наблюдение, контроль ЛП при неблагоприятном течении"
    }
  },
  "comparisons": {
