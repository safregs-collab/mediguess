  "details": {
    "cardiogenic_pulmonary_edema": {
      "description": "Кардиогенный отёк лёгких — острое повышение давления в лёгочных капиллярах с экстравазацией жидкости в интерстиций и альвеолы. Требует немедленной терапии.",
      "criteria": [
        "Острая одышка, ортопноэ, приступообразная ночная одышка",
        "Влажные хрипы, розовая пенистая мокрота",
        "Рентген: усиление лёгочного рисунка, бабочкообразные инфильтраты",
        "NT-proBNP >1800 пг/мл (сильно повышен)",
        "ЭхоКГ: снижение ФВ ЛЖ, диастолическая дисфункция"
      ],
      "prevalence": "1-2% госпитализаций",
      "complications": [
        "Кардиогенный шок",
        "Острая почечная недостаточность",
        "Респираторная недостаточность",
        "Фибрилляция предсердий",
        "Смерть (5-10% госпитальной)"
      ],
      "treatment": [
        "Сидячее положение с опущенными ногами",
        "Кислород (высокий поток, 10-15 л/мин)",
        "Нитраты (нитроглицерин 0.4-0.8 мг подъязычно или инфузия)",
        "Петлевые диуретики (фуросемид 40-80 мг в/в)",
        "Морфин 2-4 мг в/в (при тяжёлой одышке, тревоге)",
        "Неинвазивная вентиляция (CPAP/BiPAP) при гипоксемии",
        "Инотропы (добутамин) при гипотензии",
        "Лечение причины (ОИМ, аритмия, гипертонический криз)"
      ],
      "followup": "Коррекция терапии ХСН, оценка причины декомпенсации, кардиологическое наблюдение"
    },
    "cardiogenic_shock": {
      "description": "Кардиогенный шок — тяжёлое гемодинамическое нарушение с недостаточной перфузией тканей на фоне острой сердечной недостаточности. Смертность 40-50%.",
      "criteria": [
        "Систолическое АД <90 мм рт.ст. или MAP <65",
        "Снижение Cl <2.2 л/мин/м²",
        "Повышение давления заклинивания ЛА (PCWP) >15 мм рт.ст.",
        "Признаки гипоперфузии: олигурия, лактацидоз, холодная кожа"
      ],
      "prevalence": "5-8% ОИМ",
      "complications": [
        "Мультиорганная недостаточность",
        "Острая почечная недостаточность",
        "Ишемия кишечника",
        "ДИК-синдром",
        "Смерть (40-50%)"
      ],
      "treatment": [
        "Инотропная поддержка (добутамин, милринон)",
        "Вазопрессоры (норадреналин) при гипотензии",
        "ИАБП или Impella при рефрактерном шоке",
        "ЭКМО при крайней необходимости",
        "Ревascularизация (ПМЖА) при ОИМ",
        "Коррекция метаболических нарушений"
      ],
      "followup": "ОРИТ, оценка восстановления функции ЛЖ, решение о кардиохирургии"
    }
  },
