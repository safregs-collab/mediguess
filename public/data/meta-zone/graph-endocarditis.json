  "details": {
    "native_valve_endocarditis": {
      "description": "Инфекционный эндокардит нативного клапана — инфекция эндотелия сердечного клапана с формированием вегетаций. Смертность 10-20%.",
      "criteria": [
        "Модифицированные критерии Дьюка:",
        "Главные: положительные гемокультуры, вегетации на ЭхоКГ",
        "Дополнительные: лихорадка, эмболия, иммунные явления, предрасполагающее состояние",
        "Определённый ИЭ: 2 главных, или 1 главный + 3 дополнительных, или 5 дополнительных"
      ],
      "prevalence": "3-10/100 000 населения в год",
      "complications": [
        "Сердечная недостаточность (клапанная регургитация)",
        "Эмболический инсульт",
        "Абсцесс клапана/кольцевой разрыв",
        "Нарушения проводимости (блокады)",
        "Гломерулонефрит",
        "Микотические аневризмы",
        "Сепсис"
      ],
      "treatment": [
        "Антибиотики в/в 4-6 недель (по чувствительности)",
        "Streptococcus viridans: пенициллин G + гентамицин 2 недели",
        "Staphylococcus aureus: оксациллин/ванкомицин + гентамицин + рифампицин",
        "Enterococcus: ампициллин + гентамицин + ванкомицин",
        "Хирургия: показана при СН, абсцессе, неэффективности АБ, эмболиях",
        "Профилактика эмболий, контроль ЭхоКГ"
      ],
      "followup": "ЭхоКГ через 1, 3, 6, 12 месяцев, наблюдение кардиолога"
    },
    "prosthetic_valve_endocarditis": {
      "description": "Инфекционный эндокардит протеза клапана. Ранний (<1 год) — чаще стафилококки, поздний (>1 год) — похож на нативный. Смертность 20-40%.",
      "criteria": [
        "Протез клапана + критерии Дьюка",
        "Ранний: операция <1 года, стафилококки, грибки",
        "Поздний: операция >1 года, стрептококки, энтерококки"
      ],
      "prevalence": "1-3% пациентов с протезом",
      "complications": [
        "Парапротезная регургитация",
        "Абсцесс кольцевого шва",
        "Деконсценция протеза",
