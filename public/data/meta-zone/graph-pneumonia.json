  "details": {
    "community_bacterial": {
      "description": "Внебольничная бактериальная пневмония — наиболее частая форма. Возбудители: пневмококк, гемофильная палочка, моракселла.",
      "criteria": [
        "Лихорадка",
        "Кашель с гнойной мокротой",
        "Инфильтрат на рентгене",
        "Лейкоцитоз",
        "Прокальцитонин >0.25"
      ],
      "prevalence": "60% пневмоний вне стационара",
      "complications": [
        "Плеврит",
        "Абсцесс лёгкого",
        "ОРДС",
        "Сепсис"
      ],
      "treatment": [
        "Амоксицлав 1.2г 3р/день или цефтриаксон 2г + азитромицин 500мг",
        "Прокальцитонин-направленная терапия",
        "Кислород при SpO2<90%"
      ],
      "followup": "Контроль рентгена через 4-6 недель"
    },
    "viral_pneumonia": {
      "description": "Вирусная пневмония — воспаление лёгочной ткани, вызванное вирусами (грипп, РСВ, COVID-19). Часто протекает с интерстициальным поражением.",
      "criteria": [
        "Лихорадка",
        "Сухой кашель",
        "Интерстициальные изменения на рентгене",
        "Нормальный или слегка повышенный прокальцитонин",
        "Лимфопения"
      ],
      "prevalence": "15-20% пневмоний",
      "complications": [
        "Вторичная бактериальная пневмония",
        "ОРДС",
        "Сепсис"
      ],
      "treatment": [
        "Оселтамивир при гриппе",
        "Ниматрелвир/ритонавир при COVID-19",
        "Симптоматическая терапия",
        "Кислород при гипоксемии"
      ],
      "followup": "Контроль рентгена через 2-4 недели"
    }
  },
