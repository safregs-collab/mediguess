  "details": {
    "addisonian_crisis": {
      "description": "Аддисонов криз — острое обострение первичной недостаточности коры надпочечников. Смертность до 5% при своевременном лечении, до 50% без терапии.",
      "criteria": [
        "Клинические: гипотензия, гипогликемия, гипонатриемия, гиперкалиемия",
        "Кортизол <250 нмоль/л (утро) или <500 нмоль/л при стрессе",
        "АКТГ повышен (>2× верхней границы нормы) при первичной недостаточности",
        "Тест с кортикотропином: кортизол <500 нмоль/л через 60 мин"
      ],
      "prevalence": "1-2% пациентов с болезнью Аддисона",
      "complications": [
        "Гиповолемический шок",
        "Гипогликемическая кома",
        "Острая почечная недостаточность",
        "ДИК-синдром",
        "Смерть"
      ],
      "treatment": [
        "Гидрокортизон 100 мг в/в болюсно, затем 200 мг/сут инфузией",
        "0.9% NaCl 1-2 л в/в (коррекция гипонатриемии и гиповолемии)",
        "5% глюкоза при гипогликемии",
        "Коррекция гиперкалиемии (глюконат кальция, инсулин+глюкоза при К+>6.5)",
        "Поиск и лечение триггера (инфекция, отмена стероидов)",
        "Минералокортикоиды (флудрокортизон) после стабилизации"
      ],
      "followup": "Пожизненная заместительная терапия глюкокортикоидами и минералокортикоидами, ношение браслета/карты"
    },
    "secondary_adrenal_insufficiency": {
      "description": "Вторичная надпочечниковая недостаточность — дефицит АКТГ гипофиза. Нет гиперкалиемии и гиперпигментации (альдостерон сохранён).",
      "criteria": [
        "Низкий кортизол",
        "АКТГ нормальный или сниженный",
        "Нет гиперкалиемии (альдостероновая ось интактна)",
        "Нет гиперпигментации"
      ],
      "prevalence": "Редко встречается в острой форме",
      "complications": [
        "Гипогликемия",
        "Гипотензия (менее выражена)",
        "Гипонатриемия (синдром неадекватной секреции АДГ)"
      ],
      "treatment": [
        "Гидрокортизон 100 мг в/в (без минералокортикоидов)",
        "Коррекция гипогликемии",
        "Лечение основного заболевания (опухоль гипофиза, отмена стероидов)"
      ],
      "followup": "Заместительная терапия глюкокортикоидами, без минералокортикоидов"
    }
  },
