  "details": {
    "acute_pyelonephritis": {
      "description": "Острый пиелонефрит — острое инфекционное воспаление почечной паренхимы и чашечно-лоханочной системы. Возбудитель чаще E. coli (80%).",
      "criteria": [
        "Лихорадка >38°C, озноб",
        "Боль в пояснице, симптом поколачивания положительный",
        "Дизурия, частое мочеиспускание",
        "Лейкоцитурия, бактериурия, нитриты",
        "Посев мочи >10⁵ КОЕ/мл"
      ],
      "prevalence": "15-17 на 10 000 женщин, 3-4 на 10 000 мужчин",
      "complications": [
        "Эмпиема почки",
        "Почечный абсцесс",
        "Сепсис",
        "Острая почечная недостаточность",
        "Хронический пиелонефрит"
      ],
      "treatment": [
        "Антибиотики: цефтриаксон 1-2 г/сут, ципрофлоксацин 500 мг ×2 (перорально при лёгком), фторхинолоны",
        "Продолжительность: 7-14 дней (5-7 дней при парентеральном, затем перорально)",
        "Обильное питьё",
        "Анальгетики, спазмолитики",
        "Контроль посева мочи через 1-2 недели"
      ],
      "followup": "УЗИ почек через 6 недель (исключить абсцесс), контроль посева мочи"
    },
    "renal_colic": {
      "description": "Почечная колика — острая боль при обструкции мочевыводящих путей камнем. Наиболее частая причина острой боли в урологии.",
      "criteria": [
        "Внезапная интенсивная коликообразная боль в пояснице",
        "Иррадиация в пах, половые органы, бедро",
        "Гематурия (микро/макро)",
        "Тошнота, рвота",
        "УЗИ/КТ: камень, гидронефроз"
      ],
      "prevalence": "5-10% населения (жизненный риск камней)",
      "complications": [
        "Гидронефроз",
        "Инфицированный камень",
        "Острая почечная недостаточность (при двусторонней обструкции)"
      ],
      "treatment": [
        "НПВС (диклофенак, кеторолак) — первый выбор",
        "Спазмолитики (тамсулозин 0.4 мг — медицинская экспульсивная терапия)",
        "Обильное питьё",
        "При камне <10 мм — консервативная терапия",
        "При >10 мм, осложнениях — литотрипсия, уретероскопия"
      ],
      "followup": "КТ/УЗИ контроль, анализ камня, метаболическое обследование"
    }
  },
