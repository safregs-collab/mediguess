  "details": {
    "massive_pe": {
      "description": "Массивная ТЭЛА — закупорка >50% лёгочного кровотока с гемодинамической нестабильностью. Смертность до 65% без лечения.",
      "criteria": [
        "Систолическое АД <90 мм рт.ст. или снижение >40 мм рт.ст.",
        "Шок/коллапс",
        "Острая правожелудочковая недостаточность",
        "Дефекты наполнения >50% сосудистого русла на СКТ"
      ],
      "prevalence": "5% всех ТЭЛА",
      "complications": [
        "Острая правожелудочковая недостаточность",
        "Кардиогенный шок",
        "Асистолия",
        "Печёночная/почечная недостаточность"
      ],
      "treatment": [
        "Системный тромболиз (алтеплаза 100 мг в/в) — без ожидания КТ при высокой вероятностью",
        "Хирургическая эмболэктомия при противопоказаниях к тромболизу",
        "Антикоагулянты (гепарин) параллельно",
        "Вазопрессоры при гипотензии",
        "ЭКМО при рефрактерном шоке"
      ],
      "followup": "Пожизненная антикоагуляция, оценка риска рецидива"
    },
    "submassive_pe": {
      "description": "Субмассивная (промежуточная) ТЭЛА — гемодинамически стабильная, но с признаками правожелудочковой дисфункции или миокардиального повреждения.",
      "criteria": [
        "Нормотензия",
        "ЭхоКГ: дилатация ПЖ, гипокинезия",
        "Тропонин повышен",
        "NT-proBNP >600 пг/мл",
        "ЭКГ: признаки перегрузки ПЖ"
      ],
      "prevalence": "20-25% всех ТЭЛА",
      "complications": [
        "Прогрессирование до массивной ТЭЛА",
        "Хроническая тромбоэмболическая лёгочная гипертензия"
      ],
      "treatment": [
        "Антикоагулянты (НМГ → варфарин/ДОАК)",
        "Рассмотреть тромболиз при ухудшении",
        "Мониторинг в ОРИТ",
        "Фильтр нижней полой вены при противопоказаниях к антикоагулянтам"
      ],
      "followup": "3-6 месяцев антикоагуляции, оценка риска рецидива"
    }
