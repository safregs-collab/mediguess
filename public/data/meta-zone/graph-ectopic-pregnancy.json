        "Боль в плече (диафрагмальная иррадиация)",
        "Обморок",
        "УЗИ: свободная жидкость в брюшной полости"
      ],
      "prevalence": "15-20% внематочных беременностей",
      "complications": [
        "Массивное внутрибрюшное кровотечение",
        "Геморрагический шок",
        "Смерть"
      ],
      "treatment": [
        "Экстренная лапароскопия/лапаротомия",
        "Салпингэктомия (удаление трубы)",
        "Инфузионная терапия, трансфузия эритроцитов",
        "Гемостаз"
      ],
      "followup": "Контроль хГЧ до нуля, психологическая поддержка"
