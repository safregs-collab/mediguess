  "details": {
    "sepsis": {
      "description": "Сепсис — опасное для жизни состояние, вызванное дисрегулированной ответной реакцией организма на инфекцию. Критерии Sepsis-3: SOFA ≥2 при подозрении на инфекцию.",
      "criteria": [
        "Подозрение на инфекцию",
        "SOFA ≥2 (или quickSOFA ≥2: тахикардия >90, тахипноэ >22, изменение сознания)",
        "Лактат >2.0 ммоль/л"
      ],
      "prevalence": "49 млн случаев в год в мире",
      "complications": [
        "Септический шок",
        "Острая дыхательная недостаточность (ОРДС)",
        "Острая почечная недостаточность",
        "ДВС-синдром",
        "Множественная органная недостаточность"
      ],
      "treatment": [
        "Антибиотики в течение 1 часа (широкого спектра, покрывающие все вероятные возбудители)",
        "Инфузионная терапия 30 мл/кг кристаллоидов (при гипоперфузии)",
        "Вазопрессоры (норэпинефрин) для достижения САД ≥65 мм рт.ст.",
        "Контроль очага инфекции (дренаж, операция)",
        "Кортикостероиды при рефрактерном шоке (гидрокортизон 200 мг/сут)"
      ],
      "followup": "Мониторинг в ОРИТ, динамика лактата, Прокальцитонин для оценки ответа"
    },
    "septic_shock": {
      "description": "Септический шок — сепсис с гипотензией, не купирующейся объёмной терапией, требующей вазопрессоров, и лактатом >2.0 ммоль/л. Смертность 40-50%.",
      "criteria": [
        "Сепсис",
        "САД <65 мм рт.ст. или MAP <65 после 30 мл/кг кристаллоидов",
        "Лактат >2.0 ммоль/л",
        "Требуются вазопрессоры"
      ],
      "prevalence": "15-20% всех сепсисов",
      "complications": [
        "Рефрактерный шок",
        "ОРДС",
        "Острая почечная недостаточность (требует диализа)",
        "ДВС-синдром",
        "Ишемия конечностей"
      ],
      "treatment": [
        "Норэпинефрин — вазопрессор первого выбора",
        "Вазопрессин при недостаточной эффективности норэпинефрина",
        "Добутамин при миокардиальной дисфункции",
        "Гидрокортизон 200 мг/сут при рефрактерном шоке",
        "Инсулин для поддержания глюкозы 8-10 ммоль/л",
        "Трансфузия эритроцитов при Hb <70 г/л"
      ],
      "followup": "Мониторинг MAP, лактата, диуреза, динамики вазопрессоров"
    }
