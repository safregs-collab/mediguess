  "details": {
    "ischemic_stroke": {
      "description": "Ишемический инсульт — острое нарушение мозгового кровообращения, вызванное окклюзией артерии тромбом или эмболом. Наиболее частая причина — атеросклероз и фибрилляция предсердий.",
      "criteria": [
        "Внезапное начало неврологического дефицита",
        "КТ головного мозга: отсутствие кровоизлияния",
        "МРТ DWI: ограничение диффузии",
        "Симптомы соответствуют сосудистому бассейну"
      ],
      "prevalence": "85% всех инсультов",
      "complications": [
        "Мозговой отёк",
        "Транстенториальное вклинение",
        "Пневмония аспирационная",
        "Глубокая венозная тромбоз",
        "Постинсультная депрессия"
      ],
      "treatment": [
        "Внутривенный тромболиз алтеплазой (до 4.5 часов)",
        "Механическая тромбэктомия (до 24 часов при крупном сосуде)",
        "Антиагреганты (аспирин 300 мг)",
        "Антикоагулянты при ФП (гепарин/НМГ)",
        "Контроль АД <185/110 перед тромболизом"
      ],
      "followup": "Реабилитация, вторичная профилактика, контроль риск-факторов"
    },
    "hemorrhagic_stroke": {
      "description": "Внутримозговое кровоизлияние — разрыв мозгового сосуда с кровоизлиянием в паренхиму. Причины: артериальная гипертензия, антикоагулянты, амилоидная ангиопатия.",
      "criteria": [
        "Внезапная головная боль",
        "Нарушение сознания",
        "КТ: гиперплотное образование в паренхиме",
        "Неврологический дефицит"
      ],
      "prevalence": "10-15% всех инсультов",
      "complications": [
        "Внутричерепная гипертензия",
        "Гидроцефалия",
        "Рецидивное кровотечение",
        "Судороги"
      ],
      "treatment": [
        "Контроль АД (цель <140/90)",
        "Реверсия антикоагулянтов (протамин, PCC)",
        "Хирургическая эвакуация при крупной гематоме (>30 мл)",
        "Контроль ВЧД, осмотическая терапия (маннитол)"
      ],
      "followup": "Контроль АД, отказ от антикоагулянтов, реабилитация"
    }
  },
  "comparisons": {
    "diff_ischemic_vs_hemorrhagic": {
      "headers": [
