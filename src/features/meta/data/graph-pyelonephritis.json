{
  "id": "pyelonephritis",
  "label": "Пиелонефрит / Нефрология",
  "color": "#06b6d4",
  "nodes": [
    {
      "id": "wbc",
      "label": "Лейкоциты",
      "layer": "raw",
      "type": "lab",
      "unit": "×10⁹/л",
      "normal": "4-9",
      "value": 14,
      "group": "cbc",
      "description": "Лейкоциты >10×10⁹/л — инфекция. >15 — тяжёлый пиелонефрит. Лейкопения — сепсис."
    },
    {
      "id": "neutrophils",
      "label": "Нейтрофилы",
      "layer": "raw",
      "type": "lab",
      "unit": "%",
      "normal": "40-70",
      "value": 88,
      "group": "cbc",
      "description": "Нейтрофилы >75% — бактериальная инфекция. Сдвиг влево — тяжесть."
    },
    {
      "id": "crp",
      "label": "СРБ",
      "layer": "raw",
      "type": "lab",
      "unit": "мг/л",
      "normal": "<5",
      "value": 95,
      "group": "inflammation",
      "description": "СРБ >50 — воспаление. >100 — тяжёлый пиелонефрит или абсцесс."
    },
    {
      "id": "creatinine",
      "label": "Креатинин",
      "layer": "raw",
      "type": "lab",
      "unit": "мкмоль/л",
      "normal": "62-115",
      "value": 85,
      "group": "kidney",
      "description": "Креатинин — оценка функции почек. Рост при обструкции, сепсисе, дегидратации."
    },
    {
      "id": "bun",
      "label": "Мочевина",
      "layer": "raw",
      "type": "lab",
      "unit": "ммоль/л",
      "normal": "2.5-8.3",
      "value": 6,
      "group": "kidney",
      "description": "Мочевина — азотемия при обструкции, дегидратации, тяжёлом поражении почек."
    },
    {
      "id": "urine_leukocytes",
      "label": "Лейкоциты в моче",
      "layer": "raw",
      "type": "lab",
      "unit": "в п/зр",
      "normal": "<5",
      "value": 50,
      "group": "urine",
      "description": "Лейкоциты в моче >5/п.з. — пиурия. При пиелонефрите часто >50."
    },
    {
      "id": "urine_erythrocytes",
      "label": "Эритроциты в моче",
      "layer": "raw",
      "type": "lab",
      "unit": "в п/зр",
      "normal": "<3",
      "value": 10,
      "group": "urine",
      "description": "Эритроциты в моче — гематурия. При пиелонефрите умеренная (<50)."
    },
    {
      "id": "urine_bacteria",
      "label": "Бактериурия",
      "layer": "raw",
      "type": "lab",
      "group": "urine",
      "description": "Бактериурия — >10⁵ КОЕ/мл — значимая. При пиелонефрите всегда положительна."
    },
    {
      "id": "urine_nitrites",
      "label": "Нитриты в моче",
      "layer": "raw",
      "type": "lab",
      "group": "urine",
      "description": "Нитриты — продукт восстановления нитратов грам-отрицательными бактериями. Специфичны."
    },
    {
      "id": "urine_protein",
      "label": "Белок в моче",
      "layer": "raw",
      "type": "lab",
      "unit": "г/л",
      "normal": "<0.15",
      "value": 1.5,
      "group": "urine",
      "description": "Белок в моче — умеренный (<1 г/сут) при пиелонефрите. >3 г — гломерулонефрит."
    },
    {
      "id": "urine_culture",
      "label": "Посев мочи",
      "layer": "raw",
      "type": "lab",
      "group": "microbiology",
      "description": "Посев мочи — определение возбудителя и чувствительности к АБ. Золотой стандарт."
    },
    {
      "id": "blood_culture",
      "label": "Гемокультура",
      "layer": "raw",
      "type": "lab",
      "group": "microbiology",
      "description": "Гемокультура — при фебрильной температуре. Положительна при сепсисе."
    },
    {
      "id": "ultrasound_kidneys",
      "label": "УЗИ почек",
      "layer": "raw",
      "type": "instrumental",
      "group": "imaging",
      "description": "УЗИ почек — расширение ЧЛС при обструкции, абсцесс, гидронефроз."
    },
    {
      "id": "ct_kub",
      "label": "КТ без контраста (КУБ)",
      "layer": "raw",
      "type": "instrumental",
      "group": "imaging",
      "description": "КТ поясничного отдела — абсцесс, обструкция, нефролитиаз. При неясной картине."
    },
    {
      "id": "fever",
      "label": "Лихорадка / озноб",
      "layer": "findings",
      "type": "symptom",
      "severity": "высокая",
      "description": "Лихорадка >38°C — типична. Может сопровождаться ознобом. При хроническом — субфебрильная."
    },
    {
      "id": "flank_pain",
      "label": "Боль в пояснице",
      "layer": "findings",
      "type": "symptom",
      "severity": "тупая",
      "description": "Боль в пояснице — односторонняя, тупая, постоянная. Усиливается при постукивании."
    },
    {
      "id": "costovertebral_tenderness",
      "label": "Симптом поколачивания",
      "layer": "findings",
      "type": "sign",
      "description": "Боль при постукивании по поясничной области (симптом Пастернацкого) — патогномонична."
    },
    {
      "id": "dysuria",
      "label": "Дизурия",
      "layer": "findings",
      "type": "symptom",
      "description": "Дизурия — жжение при мочеиспускании. Характерна для инфекции нижних мочевых путей."
    },
    {
      "id": "frequency",
      "label": "Частое мочеиспускание",
      "layer": "findings",
      "type": "symptom",
      "description": "Частое мочеиспускание — раздражение слизистой мочевого пузыря."
    },
    {
      "id": "urgency",
      "label": "Непроизвольные позывы",
      "layer": "findings",
      "type": "symptom",
      "description": "Императивные позывы — сопутствует циститу, но может быть и при пиелонефрите."
    },
    {
      "id": "nausea",
      "label": "Тошнота",
      "layer": "findings",
      "type": "symptom",
      "description": "Тошнота — интоксикация, рефлекс с почек. Часто сопровождает тяжёлый пиелонефрит."
    },
    {
      "id": "vomiting",
      "label": "Рвота",
      "layer": "findings",
      "type": "symptom",
      "description": "Рвота — тяжёлая интоксикация. Требует парентеральной гидратации."
    },
    {
      "id": "cloudy_urine",
      "label": "Мутная моча",
      "layer": "findings",
      "type": "sign",
      "description": "Мутная моча — пиурия, бактериурия. Визуальный маркер инфекции."
    },
    {
      "id": "hematuria",
      "label": "Гематурия (макро/микро)",
      "layer": "findings",
      "type": "sign",
      "description": "Гематурия — макроскопическая или микроскопическая. При пиелонефрите умеренная."
    },
    {
      "id": "tachycardia",
      "label": "Тахикардия",
      "layer": "findings",
      "type": "sign",
      "description": "Тахикардия — лихорадка, обезвоживание, сепсис."
    },
    {
      "id": "acute_pyelonephritis",
      "label": "Острый пиелонефрит",
      "layer": "hypotheses",
      "type": "diagnosis",
      "prevalence": "60%",
      "ptp": "high",
      "description": "Острый пиелонефрит — бактериальная инфекция почек. E. coli, Proteus. Лихорадка, боль в пояснице, пиурия."
    },
    {
      "id": "renal_colic",
      "label": "Почечная колика (нефролитиаз)",
      "layer": "hypotheses",
      "type": "diagnosis",
      "prevalence": "20%",
      "ptp": "medium",
      "description": "Почечная колика — обструкция мочевыводящих путей камнем. Интенсивная иррадиирующая боль, гематурия."
    },
    {
      "id": "acute_kidney_injury",
      "label": "Острая почечная недостаточность",
      "layer": "hypotheses",
      "type": "diagnosis",
      "prevalence": "5%",
      "ptp": "low",
      "description": "ОПН — острое повреждение почек. Праненальное (гиповолемия), паренхиматозное (сепсис), постренальное (обструкция)."
    },
    {
      "id": "infected_stone",
      "label": "Инфицированный камень (стривит)",
      "layer": "hypotheses",
      "type": "diagnosis",
      "prevalence": "3%",
      "ptp": "low",
      "description": "Инфицированный камень — струвитный (инфекционный) камень. Proteus, Klebsiella. Требует дренажа + антибиотики."
    },
    {
      "id": "acute_cystitis",
      "label": "Острый цистит",
      "layer": "hypotheses",
      "type": "diagnosis",
      "prevalence": "10%",
      "ptp": "medium",
      "description": "Острый цистит — инфекция мочевого пузыря. Дизурия, частое мочеиспускание, макрогематурия. Без лихорадки."
    },
    {
      "id": "interstitial_nephritis",
      "label": "Острый интерстициальный нефрит",
      "layer": "hypotheses",
      "type": "diagnosis",
      "prevalence": "2%",
      "ptp": "low",
      "description": "Интерстициальный нефрит — аллергическая реакция на лекарства (НПВС, антибиотики). Эозинофилурия, ОПН."
    },
