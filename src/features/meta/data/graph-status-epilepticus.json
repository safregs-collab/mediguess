  "details": {
    "gcse": {
      "description": "Генерализованный конвульсивный статус эпилептикус (GCSE) — непрерывные или повторяющиеся генерализованные тонико-клонические судороги без восстановления сознания между приступами >5 мин. Смертность 10-20%.",
      "criteria": [
        "Судороги >5 мин без восстановления сознания",
        "≥2 приступа без полного восстановления между ними",
        "ЭЭГ: генерализованные эпилептиформные разряды"
      ],
      "prevalence": "10-20/100 000 населения в год",
      "complications": [
        "Нейрональная гибель (после 30 мин)",
        "Рабдомиолиз и острая почечная недостаточность",
        "Аспирационная пневмония",
        "Гипоксическая энцефалопатия",
        "Сердечная недостаточность",
        "Гипертермия"
      ],
      "treatment": [
        "Фаза 1 (0-5 мин): лоразепам 0.1 мг/кг в/в (макс 4 мг) или диазепам 10-20 мг в/в",
        "Фаза 2 (5-30 мин): фенитоин 20 мг/кг в/в или леветирацетам 60 мг/кг в/в",
        "Фаза 3 (>30 мин, рефрактерный): тиопентал/пропофол ИВЛ, мидазолам инфузия",
        "Поддержка: ИВЛ, оксигенация, коррекция АГД, лечение триггера"
      ],
      "followup": "Назначение/коррекция противоэпилептической терапии, поиск причины"
    },
    "ncse": {
      "description": "Неконвульсивный статус эпилептикус (NCSE) — изменение поведения/сознания без моторных судорог. Часто диагностируется с задержкой.",
      "criteria": [
        "Изменение сознания/поведения без конвульсий",
        "ЭЭГ: непрерывные или почти непрерывные эпилептиформные разряды",
        "Отсутствие других причин комы (метаболические, структурные)"
      ],
      "prevalence": "25% всех СЭ, часто в ОРИТ",
      "complications": [
        "Прогрессирование до GCSE",
        "Постоянные когнитивные нарушения",
        "Смертность 18-50% (зависит от основного заболевания)"
      ],
      "treatment": [
        "Лоразепам 0.1 мг/кг в/в",
        "Вальпроевая кислота 30 мг/кг в/в",
        "Леветирацетам 60 мг/кг в/в",
        "Мидазолам инфузия при рефрактерности"
      ],
      "followup": "ЭЭГ-мониторинг, коррекция терапии"
    }
  },
