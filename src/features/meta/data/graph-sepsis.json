{
  "id": "sepsis",
  "label": "Сепсис",
  "color": "#7c3aed",
  "nodes": [
    {
      "id": "lactate",
      "label": "Лактат",
      "layer": "raw",
      "type": "lab",
      "unit": "ммоль/л",
      "normal": "0.5-1.6",
      "value": 4.5,
      "group": "metabolism",
      "description": "Маркер тканевой гипоперфузии. При сепсисе >2.0 ммоль/л указывает на тяжесть, >4.0 — высокий риск смертности."
    },
    {
      "id": "procalcitonin",
      "label": "Прокальцитонин",
      "layer": "raw",
      "type": "lab",
      "unit": "нг/мл",
      "normal": "<0.05",
      "value": 45,
      "group": "inflammation",
      "description": "Специфический маркер бактериальной инфекции. >0.5 нг/мл — вероятен сепсис, >2.0 — высокая вероятность тяжёлого сепсиса."
    },
    {
      "id": "crp",
      "label": "СРБ",
      "layer": "raw",
      "type": "lab",
      "unit": "мг/л",
      "normal": "<5",
      "value": 280,
      "group": "inflammation",
      "description": "Неспецифический острофазовый белок. Быстро растёт при инфекции, но запаздывает на 6–12 ч от начала."
    },
    {
      "id": "wbc",
      "label": "Лейкоциты",
      "layer": "raw",
      "type": "lab",
      "unit": "×10⁹/л",
      "normal": "4-9",
      "value": 2.5,
      "group": "cbc",
      "description": "Лейкоцитарная формула. Лейкопения (<4) при тяжёлом сепсисе — плохой прогностический знак."
    },
    {
      "id": "platelets",
      "label": "Тромбоциты",
      "layer": "raw",
      "type": "lab",
      "unit": "×10⁹/л",
      "normal": "150-400",
      "value": 45,
      "group": "cbc",
      "description": "Тромбоцитопения — критерий DIC и тяжести сепсиса по SOFA. <100×10⁹/л — 2 балла SOFA."
    },
    {
      "id": "creatinine",
      "label": "Креатинин",
      "layer": "raw",
      "type": "lab",
      "unit": "мкмоль/л",
