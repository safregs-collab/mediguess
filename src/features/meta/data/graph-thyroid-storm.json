  "details": {
    "thyroid_storm": {
      "description": "Тиреотоксический криз — экстремальное обострение тиреотоксикоза с высокой смертностью (10-30%). Требует немедленной интенсивной терапии.",
      "criteria": [
        "BWPS ≥45 — высокая вероятность криза",
        "Температура >38.5°C (особенно >40°C)",
        "Тахикардия >140/мин или фибрилляция предсердий",
        "ЦНС: агитация, делирий, кома",
        "ЖКТ: рвота, диарея, илеус",
        "Сердечная недостаточность",
        "Острая почечная недостаточность"
      ],
      "prevalence": "1-2% госпитализаций с тиреотоксикозом",
      "complications": [
        "Сердечная недостаточность",
        "Фибрилляция предсердий",
        "Инсульт (эмболический)",
        "Острая почечная недостаточность",
        "Печёночная недостаточность",
        "ДИК-синдром",
        "Смерть"
      ],
      "treatment": [
        "Тиамазол 60-80 мг/сут в/в или перорально",
        "Йодид калия (SSKI) через 1 час после тиамазола",
        "Пропранолол 60-80 мг/сут (β-блокатор)",
        "Гидрокортизон 300 мг/сут (ингибирует конверсию Т4→Т3)",
        "Охлаждение (без аспирина — усиливает связывание Т3)",
        "Жидкостная терапия, электролиты",
        "ОРИТ, мониторинг"
      ],
      "followup": "Пожизненная терапия тиреостатиками или радиойодтерапия/тиреоидэктомия"
    },
    "severe_hyperthyroidism": {
      "description": "Тяжёлый тиреотоксикоз без полного критерия криза. Требует госпитализации и агрессивной терапии.",
      "criteria": [
        "BWPS 25-44 — промежуточная вероятность",
        "Тахикардия 120-140/мин",
        "Температура 38-39°C",
        "Нет комы или тяжёлой СН"
      ],
      "prevalence": "5-10% тиреотоксикоза",
      "complications": [
        "Прогрессирование до криза",
        "Фибрилляция предсердий",
        "Остеопороз"
      ],
      "treatment": [
        "Тиамазол 30-40 мг/сут",
        "Пропранолол 40-60 мг/сут",
        "Мониторинг в стационаре"
      ],
      "followup": "Оценка показаний к радиойоду или операции"
    }
  },
