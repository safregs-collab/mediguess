        "ОРДС",
        "Сепсис"
      ],
      "treatment": [
        "Оселтамивир при гриппе",
        "Ниматрелвир/ритонавир при COVID-19",
        "Симптоматическая терапия",
        "Кислород при гипоксемии"
      ],
      "followup": "Контроль рентгена через 2-4 недели"
