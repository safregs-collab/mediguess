  "details": {
    "acute_appendicitis": {
      "description": "Острый аппендицит — острое воспаление червеобразного отростка слепой кишки. Наиболее частая причина острого живота, требующая хирургического вмешательства.",
      "criteria": [
        "Миграция боли из эпигастрия в правую подвздошную область",
        "Болезненность в точке Мак-Бёрни",
        "Положительный симптом Блюмберга",
        "Лейкоцитоз >10×10⁹/л, сдвиг влево",
        "УЗИ/КТ: утолщение стенки аппендикса >6 мм"
      ],
      "prevalence": "7-8% населения (жизненный риск)",
      "complications": [
        "Перфорация аппендикса",
        "Аппендикулярный абсцесс",
        "Диффузный перитонит",
        "Портальный пиофлебит",
        "Сепсис"
      ],
      "treatment": [
        "Аппендэктомия — золотой стандарт (лапароскопическая предпочтительнее)",
        "Консервативное лечение антибиотиками возможно при неосложнённом аппендиците (выборочно)",
        "Перфорированный аппендицит: экстренная операция + антибиотики",
        "Абсцесс: дренаж + отсроченная аппендэктомия"
      ],
      "followup": "При консервативном лечении — плановая аппендэктомия через 6-8 недель"
    },
    "perforated_appendicitis": {
      "description": "Перфорированный аппендицит — разрыв стенки аппендикса с выпотом содержимого в брюшную полость. Смертность до 5%.",
      "criteria": [
        "Симптомы аппендицита >48 часов",
        "Общее мышечное напряжение живота",
        "Высокая температура >38.5°C",
        "Лейкоцитоз >15×10⁹/л",
        "КТ: свободная жидкость/газ в брюшной полости"
      ],
      "prevalence": "10-20% острого аппендицита",
      "complications": [
        "Диффузный перитонит",
        "Сепсис",
        "Внутрибрюшные абсцессы",
        "Портальный пиофлебит"
      ],
      "treatment": [
        "Экстренная лапаротомия/лапароскопия",
        "Промывание брюшной полости",
        "Антибиотики широкого спектра (цефалоспорины + метронидазол)",
        "Дренирование при локализованном абсцессе"
      ],
      "followup": "Контроль УЗИ/КТ через 7-10 дней, мониторинг инфекции"
    }
  },
